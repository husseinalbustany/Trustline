# Owner role: runs migrations and the seed. Never used by the running API.
DATABASE_URL=postgres://trustline:trustline@localhost:5432/trustline
# Application role: what the API connects as. Subject to row-level security.
APP_DATABASE_URL=postgres://trustline_app:trustline_app@localhost:5432/trustline
# Platform role: what the admin portal's API connects as. No tenant data.
PLATFORM_DATABASE_URL=postgres://trustline_platform:trustline_platform@localhost:5432/trustline

API_PORT=3001
# The address the API listens on. Unless set, this machine only (127.0.0.1):
# nothing but the web app next to it can connect. The API believes the
# X-Forwarded-For header it is handed, so it must never be open to anyone
# but the web app. Where the web app is on another machine or in another
# container, set this to the address it reaches the API on (0.0.0.0 for all)
# and let the network allow only the web app to connect.
# API_HOST=127.0.0.1

# How the API learns a caller's address, for the limits on the routes that
# need no sign-in and for the address kept with each sign-in.
#
# REQUIRED IN PRODUCTION, all three (README, "In front of the web app"):
#
# 1. A reverse proxy in front of the web app writes X-Forwarded-For.
#    - The outermost proxy (the one the internet connects to) sets it to the
#      address of whoever connected to it, replacing anything the sender put
#      there. nginx: `proxy_set_header X-Forwarded-For $remote_addr;`
#    - Every proxy behind it adds the address of whoever connected to it
#      after what is already there, and must not replace the header.
#      nginx: `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`
#    The web app passes the header to the API as it received it and does not
#    correct it.
#
# 2. The web app and the API can be reached only through that proxy: the web
#    app's port from the proxy alone, the API's port from the web app alone
#    (API_HOST above). Whoever reaches either directly chooses the address
#    they are counted by.
#
# 3. TRUST_PROXY_HOPS is the number of proxies in front of the web app that
#    write the header:
#      1  one proxy, then the web app, then the API (the default)
#      2  two proxies in a row that each add their entry (CDN, then load
#         balancer)
#      0  only if the API is reached directly, with no web app or proxy in
#         front
#    The API does not start on anything but a whole number from 0 to 9, and
#    logs the value it uses, with the address it listens on, when it starts.
#
# Without such a proxy no value is right. Left at 1, anyone can send their
# own X-Forwarded-For and get a fresh allowance with every request; with no
# header, or at 0, every caller is counted as the web app and shares one
# allowance, so one person can use it up for everybody. The ceiling of 60
# public reports an hour per hospital holds either way.
# TRUST_PROXY_HOPS=1

# Email (docs/specs/email.md). Notifications are also sent by email: what
# cannot wait at once, and a daily digest at 07:00 on each organization's
# clock. Unless SMTP_HOST is set, nothing is sent: every email is kept in the
# email_outbox table, and the API says so in its log. A setting that is
# missing or wrong in SMTP mode is named in the log (never its value) and
# the API keeps mail in the outbox instead; it never stops the API.
#
# The SMTP server of whichever mail service is used. Unset: outbox mode.
# SMTP_HOST=smtp.mail-service.example
# 587 unless set (465 with SMTP_TLS=implicit).
# SMTP_PORT=587
# starttls (the default: the server must offer STARTTLS, or nothing is
# sent), implicit (TLS from the first byte, usually port 465), or none (only
# for a server on this machine, such as a local relay). Certificates are
# always verified.
# SMTP_TLS=starttls
# Both or neither. Never logged.
# SMTP_USER=
# SMTP_PASSWORD=
# The sender. Required in SMTP mode; the name defaults to Trustline.
# MAIL_FROM_ADDRESS=no-reply@trustline.example
# MAIL_FROM_NAME=Trustline
# Where the links in an email lead: the web app's address, https. Required
# in SMTP mode; http://localhost:3000 in outbox mode unless set.
# WEB_BASE_URL=https://trustline.example
# Signs the unsubscribe link of each email: 32 characters or more, random,
# the same in every API process, kept secret. Required in SMTP mode;
# changing it ends every unsubscribe link already sent. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# EMAIL_LINK_SECRET=
# outbox: keep mail in the outbox whatever else is set (the tests do).
# MAIL_TRANSPORT=

# Signing PIN (docs/specs/identity-signing-pin.md): a secret of 32
# characters or more, the same in every API process, kept out of the
# database. Each signing PIN is combined with it before it is hashed, so a
# copy of the database alone does not give the PINs up to guessing.
# Without it no PIN is set or checked. Changing it voids every PIN. Generate
# one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SIGNING_PIN_PEPPER=

# The audit trail's signed checkpoints (docs/specs/audit-trail.md). Every
# day the API checks each client's hash chain and signs its head with this
# Ed25519 private key: PKCS#8, as a PEM or as the DER in base64 on one line.
# Held outside the database (a secret of the deployment or a key service),
# never in a table, and never shown: the API logs only the variable's name.
# Without it the API runs all the same, and the checks record unsigned
# checkpoints, which no check trusts. Generate one with:
#   node -e "console.log(require('node:crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# AUDIT_SIGNING_KEY=
#
# When the key is replaced, keep checking what the old one signed: its
# public key (SPKI, base64 DER or PEM), comma-separated if several. Both
# kinds are published at /api/v1/audit/keys.
# AUDIT_PREVIOUS_PUBLIC_KEYS=
#
# Key ids deliberately retired, whose public key is no longer kept: a
# checkpoint signed by one is passed over. Any other unknown key id is
# taken for a break. Comma-separated.
# AUDIT_RETIRED_KEY_IDS=
#
# In production (NODE_ENV=production) the API does not start without a
# valid AUDIT_SIGNING_KEY.
#
# The day the API began signing checkpoints, if it ran without a key before
# (ISO date). With a key configured, an unsigned checkpoint older than this
# is passed over; any other unsigned one is taken for a break.
# AUDIT_SIGNED_SINCE=

# AI providers (docs/specs/ai-providers-and-allowances.md). Which provider
# and model serve each client's AI features is set by Trustline's staff in
# the admin portal; each provider connection there names the environment
# variable its credential is in. Credentials live here only: never in the
# database, never typed into a screen, never logged or shown (the portal
# shows only whether a connection's variable is set).
#
# fake (the default, and always under test): every AI request is answered
# by a deterministic fake provider that never touches the network, and no
# credential is needed. real: requests go to the configured providers, and
# only when NODE_ENV=production as well; otherwise the API says it is using
# the fake provider in its log, and does.
# AI_PROVIDERS=fake
#
# One variable per connection, named AI_CREDENTIAL_<NAME> (no other name is
# accepted, so that no connection can be pointed at another secret). For an
# Anthropic API connection, its API key. For an Amazon Bedrock connection,
# either a Bedrock API key, or ACCESS_KEY_ID:SECRET_ACCESS_KEY, optionally
# followed by :SESSION_TOKEN. The seed's demo connections name these two:
# AI_CREDENTIAL_ANTHROPIC_DEMO=
# AI_CREDENTIAL_BEDROCK_DEMO=
