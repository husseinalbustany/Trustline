# Owner role: runs migrations and the seed. Never used by the running API.
DATABASE_URL=postgres://trustline:trustline@localhost:5432/trustline
# Application role: what the API connects as. Subject to row-level security.
APP_DATABASE_URL=postgres://trustline_app:trustline_app@localhost:5432/trustline
# Platform role: what the admin portal's API connects as. No tenant data.
PLATFORM_DATABASE_URL=postgres://trustline_platform:trustline_platform@localhost:5432/trustline

API_PORT=3001

# How the API learns a caller's address, for the limits on the routes that
# need no sign-in and for the address kept with each sign-in.
#
# REQUIRED IN PRODUCTION: a reverse proxy in front of the web app that sets
# X-Forwarded-For to the address of whoever connected to it, replacing
# anything the sender put in that header (nginx: `proxy_set_header
# X-Forwarded-For $remote_addr;`). The web app passes the header to the API
# as it received it and does not correct it.
#
# TRUST_PROXY_HOPS is the number of proxies in front of the web app that
# write the header:
#   1  one proxy, then the web app, then the API (the default)
#   2  two proxies in a row that each add their entry (CDN, then load balancer)
#   0  only if the API is reached directly, with no web app or proxy in front
#
# Without such a proxy no value is right. Left at 1, anyone can send their
# own X-Forwarded-For and get a fresh allowance with every request; with no
# header, or at 0, every caller is counted as the web app and shares one
# allowance, so one person can use it up for everybody. The ceiling of 60
# public reports an hour per hospital holds either way.
# TRUST_PROXY_HOPS=1
